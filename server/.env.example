# Copy to .env and adjust. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Production: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Development only: folder for the embedded database (empty = in-memory)
PGLITE_DATA_DIR=.data/pglite
# Uploaded photos/documents (keep outside any public web folder; back it up with the database)
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_MB=5
# Largest number of rows a single report table may export (PDF/Excel).
REPORT_MAX_ROWS=20000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_APP_URL=http://localhost:8081
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
# Help assistant (optional): which AI service answers staff "how do I...?" questions — gemini or claude.
# Keep keys only in the server's secret store / environment — never in the app or in git. No key = assistant off.
ASSISTANT_PROVIDER=gemini
# Google Gemini key from https://aistudio.google.com/apikey. Free tier: Google may use prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Claude key from console.anthropic.com (needs prepaid credit). Default model claude-haiku-5-5.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
