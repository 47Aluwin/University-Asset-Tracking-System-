{
  "name": "uats-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node src/cli/migrate.ts",
    "create-admin": "node src/cli/create-admin.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "seed-dev": "node src/cli/seed-dev.ts",
    "backup": "node src/cli/backup.ts",
    "restore": "node src/cli/restore.ts",
    "cleanup-uploads": "node src/cli/cleanup-uploads.ts",
    "test:pg-wire": "node --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.12",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@google/genai": "^2.32.0",
    "@node-rs/argon2": "^2.2.2",
    "exceljs": "4.4",
    "fastify": "^5.12.7",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.17",
    "@electric-sql/pglite-tools": "^0.4.14",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
