# Copy to .env.local (git-ignored). Values starting with EXPO_PUBLIC_ are bundled into the app and are
# visible to anyone who has it — never put secrets here.
#
# Address of the API as seen from the device running the app:
#   browser on this computer:  http://localhost:4000/api/v1
#   Android emulator:          http://10.0.2.2:4000/api/v1
#   phone on the same Wi-Fi:   http://<this computer's LAN IP>:4000/api/v1  (start the API with HOST=0.0.0.0)
#   production:                https://<api host>/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional demo account box on the sign-in page (testers/reviewers). Leave EMPTY in production:
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone. Use a demo-only account.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
